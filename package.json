{
    "name": "mandala-grid",
    "version": "1.2.18",
    "description": "Mandala grid (3×3 / 9×9) editor for Obsidian.",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "reload:plugin": "obsidian plugin:reload id=mandala-grid",
        "reload:plugin:wait": "node scripts/reload-plugin-after-delay.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/sync-manifest.mjs",
        "validate:release": "node scripts/validate-release.mjs",
        "validate:official": "npm run lint:review && npm run build && npm run validate:release",
        "sync:obsidian": "node scripts/sync-obsidian.mjs",
        "build:sync": "npm run build && npm run sync:obsidian",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "test:watch": "vitest",
        "test": "vitest run",
        "prepare": "husky install",
        "lint": "eslint src",
        "lint:review": "eslint \"src/**/*.{ts,svelte}\" --ignore-pattern \"**/*.spec.ts\" --ignore-pattern \"src/shared/test-helpers/**\"",
        "lint:fix": "eslint . --fix"
    },
    "keywords": [],
    "author": "dusk",
    "license": "MIT",
    "devDependencies": {
        "@commitlint/cli": "17.4.0",
        "@commitlint/config-conventional": "17.4.0",
        "@eslint/js": "^9.39.2",
        "@eslint/json": "^0.14.0",
        "@tsconfig/svelte": "5.0.2",
        "@types/electron": "1.6.10",
        "@types/jsdom": "21.1.7",
        "@types/node": "20.11.24",
        "@types/uniqid": "5.3.4",
        "@typescript-eslint/parser": "^8.56.1",
        "@typescript-eslint/utils": "^8.54.0",
        "esbuild": "0.20.1",
        "esbuild-plugin-inline-worker": "0.1.1",
        "esbuild-svelte": "0.9.5",
        "eslint": "^9.39.2",
        "eslint-plugin-obsidianmd": "^0.3.0",
        "eslint-plugin-svelte": "^3.14.0",
        "husky": "8.0.3",
        "jsdom": "24.0.0",
        "obsidian": "1.13.1",
        "prettier": "3.2.5",
        "prettier-plugin-svelte": "3.2.2",
        "svelte": "5.57.2",
        "svelte-check": "4.7.6",
        "svelte-eslint-parser": "^1.4.1",
        "svelte-preprocess": "6.0.5",
        "tslib": "2.6.2",
        "typescript": "5.3.3",
        "typescript-eslint": "^8.54.0",
        "vitest": "1.3.1"
    },
    "dependencies": {
        "@codemirror/state": "6.5.0",
        "@codemirror/view": "6.38.6",
        "classnames": "2.5.1",
        "fuse.js": "7.0.0",
        "html-to-image": "^1.11.13",
        "lucide-svelte": "0.344.0",
        "monkey-around": "3.0.0",
        "nanoid": "5.1.16",
        "tiny-invariant": "1.3.3"
    },
    "overrides": {
        "obsidian": {
            "moment": "2.31.0"
        }
    }
}
